# Immutable deployment image. Use the lowercase GHCR repository name and a full commit SHA.
BACKEND_IMAGE=ghcr.io/github-owner/repository
IMAGE_TAG=replace-with-git-commit-sha
HTTP_PORT=8088

# PostgreSQL
POSTGRES_DB=trucvanban
POSTGRES_USER=trucvanban
POSTGRES_PASSWORD=replace-with-a-strong-password

# Redis
REDIS_PASSWORD=replace-with-a-strong-password

# RabbitMQ
RABBITMQ_USERNAME=trucvanban
RABBITMQ_PASSWORD=replace-with-a-strong-password

# MinIO
MINIO_ACCESS_KEY=replace-with-an-access-key
MINIO_SECRET_KEY=replace-with-a-strong-secret-key
MINIO_BUCKET=documents

# Application security (JWT_SECRET must be a Base64-encoded secret suitable for HS256.)
JWT_SECRET=replace-with-a-base64-encoded-256-bit-secret
HMAC_MASTER_KEY=replace-with-a-strong-master-key

# Optional tuning and integration settings
OUTBOX_PUBLISHER_FIXED_DELAY_MS=5000
VISUAL_SIGNATURE_EXTERNAL_ASSET_TIMEOUT_MS=10000
CLIENT_SIMULATOR_GATEWAY_URL=http://localhost:8080/api/v1/exchange
CLIENT_SIMULATOR_MULTI_SIG_URL=http://localhost:8080/api/v1/exchange-documents/signatures
CLIENT_SIMULATOR_PRIVATE_KEY_PATH=src/main/resources/keys/simulator_private_key.pem
